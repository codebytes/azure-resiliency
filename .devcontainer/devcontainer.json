// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Azure Resiliency Slides",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Avoid resolving a worktree's host-only .git pointer inside the container.
	"postStartCommand": "git -C / config --global --add safe.directory \"${containerWorkspaceFolder}\" || true",
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"markdown.marp.diagnostics.slideContentOverflow": true,
				"markdown.marp.html": "all",
				"markdown.marp.exportType": "html",
				"markdown.marp.pptx.editable": "smart",
				"markdown.marp.themes": [
					"./slides/themes/custom.css",
					"./slides/themes/custom-default.css",
					"./slides/themes/custom-gaia.css",
					"./slides/themes/custom-uncover.css",
					"./slides/themes/vsl.css"
				]
			},
			"extensions": [
				"streetsidesoftware.code-spell-checker",
				"yzhang.markdown-all-in-one",
				"marp-team.marp-vscode",
				"bierner.markdown-mermaid",
				"hediet.vscode-drawio"
			]
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
